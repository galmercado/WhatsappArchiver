# Copy to .env (git-ignored). Compose reads it automatically.

# --- which auth mode (pick ONE COMPOSE_FILE line) ---
COMPOSE_FILE=docker-compose.yml:docker-compose.password.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.google.yml
WA_AUTH_MODE=password_totp
#WA_AUTH_MODE=google

# --- archive produced by extract_and_ingest.py (mounted read-only) ---
WA_ARCHIVE_PATH=./archive

# --- dev profile ---
WA_PORT=8000

# --- prod profile ---
WA_DOMAIN=archive.example.com
ACME_EMAIL=you@example.com

# --- google mode (client secret goes in secrets/google_client_secret, NOT here) ---
#WA_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
#WA_GOOGLE_ALLOWED_EMAIL=you@gmail.com
#WA_GOOGLE_ALLOWED_SUB=

# --- remote-access alternatives to Caddy ---
#CLOUDFLARE_TUNNEL_TOKEN=
#TS_AUTHKEY=
#TS_HOSTNAME=wa-archive
